{
  "compilerOptions": {
    "strict": true,
    "target":"ES2021",
    "lib": ["es2022", "DOM" ],
    "module": "ES2022",
    "baseUrl": "./netlify/functions/",
    "paths": {
      "@components/*": ["./components/*"],
      "@resources/*": ["./resources/*"],
    },
    
    "types": ["node"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
