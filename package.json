{
  "name": "theideaiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "analyze": "turbo analyze",
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "cap:sync": "turbo cap:sync --filter=app",
    "check": "ultracite check",
    "check:i18n": "bun scripts/check-i18n.ts",
    "check:placeholders": "bun scripts/check-placeholders.ts",
    "check:rtl": "bun scripts/check-rtl.ts",
    "check:secrets": "bun scripts/check-secrets.ts",
    "check:unused": "knip",
    "clean": "git clean -xdf node_modules",
    "db:reset": "bun run --cwd packages/database db:reset",
    "db:start": "bun run --cwd packages/database db:start",
    "db:stop": "bun run --cwd packages/database db:stop",
    "db:test": "bun run --cwd packages/database db:test",
    "db:types": "bun run --cwd packages/database db:types",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "gen:package": "turbo gen package",
    "test": "turbo test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo typecheck"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "launch-editor": "^2.14.2",
    "parse5": "^7.2.1",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "vite": "^8.3.5",
    "webpack-dev-middleware": "^7.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.14",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "knip": "^6.40.0",
    "turbo": "^2.8.14",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
