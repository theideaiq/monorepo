{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "**/generated/**",
        "storybook-static/**"
      ]
    },
    "build:native": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "cap:sync": {
      "cache": false,
      "dependsOn": ["build:native"]
    },
    "typecheck": {},
    "test": {},
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_*",
    "NEXT_PUBLIC_*",
    "SKIP_ENV_VALIDATION",
    "ANALYZE",
    "BUILD_TARGET",
    "CAP_SERVER_URL",
    "SUPABASE_INTEGRATION",
    "SUPABASE_SECRET_KEY",
    "API_URL",
    "PUBLISHABLE_KEY",
    "SECRET_KEY",
    "AI_*",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPENAI_API_KEY",
    "ARCJET_KEY",
    "BETTERSTACK_*",
    "CRON_SECRET",
    "META_*",
    "TIKTOK_*",
    "PAYMENTS_PROVIDER",
    "WAYL_*",
    "RESEND_*",
    "SENTRY_*",
    "STORE_NOTIFICATIONS_EMAIL",
    "TELEGRAM_*",
    "UPSTASH_*",
    "E2E_*",
    "PLAYWRIGHT_*"
  ]
}
