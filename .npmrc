# --- Node Environment ---
# Enforce the strict Node.js version (>=24.0.0) defined in package.json
engine-strict=true

# --- Dependency Resolution ---
# Automatically resolve complex peer dependency conflicts
auto-install-peers=true
# Prevent fatal installation crashes due to third-party packages with outdated peer requirements (e.g., React 19)
strict-peer-dependencies=false

# --- Monorepo (Workspace) Optimizations ---
# Ensure 'pnpm add' always uses the 'workspace:*' protocol for internal packages
save-workspace-protocol=workspace:*
# Strictly favor local workspace packages over remote registry packages
prefer-workspace-packages=true

# --- Hoisting Pattern (The Bridge for Storybook/Next.js) ---
# Explicitly hoist Next.js and its internal configurations so Storybook can resolve 'next/config'
public-hoist-pattern[]=*next*
