{
  "name": "@repo/database",
  "version": "0.0.0",
  "exports": {
    ".": "./index.ts",
    "./admin": "./admin.ts",
    "./keys": "./keys.ts",
    "./types": "./types.ts"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint --level warning",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "bun scripts/sync-test-preamble.ts --check && supabase test db",
    "db:test:sync": "bun scripts/sync-test-preamble.ts",
    "db:types": "supabase gen types typescript --local --schema public | biome format --stdin-file-path=types.ts > types.ts.tmp && mv types.ts.tmp types.ts",
    "functions:serve": "supabase functions serve",
    "migration:new": "supabase migration new",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.1",
    "supabase": "2.121.0",
    "typescript": "^7.0.2"
  }
}
