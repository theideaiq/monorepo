# ── The IDEA's sites (return_to after sign-in must be on one of these hosts) ─
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3005"
NEXT_PUBLIC_DESIGN_URL=""
# This app's own URL.
NEXT_PUBLIC_PASS_URL="http://localhost:3006"

# ── Session cookie ─────────────────────────────────────────────────────────
# Production: ".theideaiq.com", so every subdomain reads the same session.
# Leave empty locally and on previews (host-only cookie).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""
