# The IDEA Design (design.theideaiq.com). Only the Next.js shell (bun run
# build && bun run start) reads these; `bun run dev` is plain Storybook.

# ── Sign-in: The IDEA Pass, in The IDEA Spark ─────────────────────────────
# Signed-out visitors go to /sign-in on The IDEA Spark, staff without an
# authenticator-app session to /mfa. Defaults to http://localhost:3000 in
# development and https://spark.theideaiq.com in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
# The gate verifies the shared session cookie and reads the visitor's own
# staff row under Row Level Security. Unset = every request gets a 503.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
