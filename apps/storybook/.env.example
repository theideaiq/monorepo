# The IDEA Design (design.theideaiq.com). Only the Next.js shell (bun run
# build && bun run start) reads these; `bun run dev` is plain Storybook.

# ── Sign-in: The IDEA Pass ─────────────────────────────────────────────────
# Signed-out visitors go to Pass /sign-in, staff without an authenticator-app
# session to Pass /mfa. Defaults to http://localhost:3006 in development.
NEXT_PUBLIC_PASS_URL="http://localhost:3006"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
# The gate verifies the shared session cookie and reads the visitor's own
# staff row under Row Level Security. Unset = every request gets a 503.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
