# The IDEA Spark (apps/app): the back office and The IDEA Suite. Public
# values only (NEXT_PUBLIC_*): secrets belong in apps/api, which this app
# calls with the signed-in user's token (`bun run check:secrets`).

# ── App URLs ───────────────────────────────────────────────────────────────
# This app's own URL (production: https://spark.theideaiq.com).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The website, where The IDEA Pass signs people in (`passUrl()`).
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# apps/api: checkout and staff lookup (user's token).
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
# The IDEA Design (apps/storybook): also an allowed return_to after sign-in.
NEXT_PUBLIC_DESIGN_URL="http://localhost:6006"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
# Every query runs as the signed-in user, so Row Level Security applies.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Session cookie (shared with the website and the design site) ──────────
# Production: ".theideaiq.com", so every subdomain reads the same session.
# Leave empty locally and on previews (host-only cookie).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""

# ── Analytics ──────────────────────────────────────────────────────────────
# The GA4, Meta and TikTok ids load those tags directly; events come from
# track() in @repo/analytics/client. The back office loads no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""
