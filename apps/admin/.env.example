# ── App URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# apps/api: campaign sending and staff lookup, called with the staff token.
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
# Every query runs as the signed-in staff member, so Row Level Security applies.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Local development only ─────────────────────────────────────────────────
# "true" skips the authenticator-app (TOTP) step under `next dev` when the
# local Supabase stack has MFA disabled. Never honoured in production builds.
ADMIN_SKIP_MFA=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""
