# apps/app is client-first: it runs in the browser and inside the iOS/Android
# apps, so every variable here is public (NEXT_PUBLIC_*). Secrets belong in
# apps/api, which this app calls with the signed-in user's token.

# ── App URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
# The IDEA Pass (apps/pass): sign-in, sign-up and the authenticator app.
NEXT_PUBLIC_PASS_URL="http://localhost:3006"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Session cookie (shared with The IDEA Pass) ─────────────────────────────
# Production: ".theideaiq.com", so every subdomain reads the same session.
# Leave empty locally and on previews (host-only cookie).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""

# ── Analytics ──────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_GTM_ID to manage every tag in Google Tag Manager, or set the
# GA4, Meta and TikTok ids to load those tags directly. Ad pixels never load
# inside the native apps.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""

