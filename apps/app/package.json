{
  "name": "app",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "cap:add": "bun native/prepare.ts && cap add ios && cap add android",
    "cap:assets": "bunx @capacitor/assets generate --assetPath native/assets --iconBackgroundColor '#D81B60' --splashBackgroundColor '#D81B60' --splashBackgroundColorDark '#D81B60'",
    "cap:doctor": "cap doctor",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "bun native/prepare.ts && cap run android",
    "cap:run:ios": "bun native/prepare.ts && cap run ios",
    "cap:sync": "bun native/prepare.ts && cap sync",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "next dev -p 3001",
    "start": "next start",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@repo/analytics": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/commerce": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/internationalization": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/payments": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/seo": "workspace:*",
    "@repo/storage": "workspace:*",
    "@sentry/nextjs": "^10.42.0",
    "@supabase/supabase-js": "^2.115.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.104.1",
    "import-in-the-middle": "^3.0.0",
    "lucide-react": "^1.41.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "require-in-the-middle": "8.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "uqr": "0.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
