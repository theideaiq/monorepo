# Staff (apps/staff, staff.theideaiq.com): the tools The IDEA's team uses,
# and the design site at /design. Public values only (NEXT_PUBLIC_*):
# secrets belong in apps/api, which this app calls with the signed-in staff
# member's token (`bun run check:secrets`).

# ── App URLs ───────────────────────────────────────────────────────────────
# This app's own URL (production: https://staff.theideaiq.com). Locally it
# runs on port 3003 of localhost, so the Pass session cookie (which ignores
# ports) signs staff in here too.
NEXT_PUBLIC_STAFF_URL="http://localhost:3003"
# The IDEA Partners (required by the shared URL settings).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The website, where The IDEA Pass signs people in (`passUrl()`).
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# apps/api: shipments, staff lookup and other Staff calls (user's token).
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
# Every query runs as the signed-in staff member, so Row Level Security applies.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Session cookie (shared with the website) ──────────────────────────────
# Production: ".theideaiq.com", so every subdomain reads the same session.
# Leave empty locally and on previews (host-only cookie).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""
