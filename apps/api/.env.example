# ── App URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Cron (Vercel sends it as a Bearer token; `openssl rand -hex 32`) ───────
CRON_SECRET=""

# ── Supabase (Settings → API Keys) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ── Payments (Wayl) ────────────────────────────────────────────────────────
# Without WAYL_API_TOKEN the in-memory mock provider is used (development only).
PAYMENTS_PROVIDER=""
WAYL_API_TOKEN=""
# 10–255 random characters; Wayl signs webhooks with it (`openssl rand -hex 32`).
WAYL_WEBHOOK_SECRET=""
# "test" while integrating, "live" for real charges.
WAYL_ENV="test"
# Optional: https://api.thewayl-staging.com for Wayl's staging server.
WAYL_API_URL=""

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Receipts, renewal invoices and the website's contact form (POST /contact,
# delivered to supportEmail in packages/config/project.json).
RESEND_FROM=""
RESEND_TOKEN=""
# Optional: gets an email for every paid store order.
STORE_NOTIFICATIONS_EMAIL=""

# ── Security (Arcjet) — the website's public forms ─────────────────────────
# Shield, bot detection, a burst limit and undeliverable-address checks on
# POST /contact (`ajkey_…`). Without it the form still validates and is
# rate limited by Upstash below.
ARCJET_KEY=""

# ── Telegram bot (Droid) ───────────────────────────────────────────────────
# From @BotFather. Then run `bun run --cwd apps/api telegram:setup`.
TELEGRAM_BOT_TOKEN=""
# Sent by Telegram with every webhook call (`openssl rand -hex 32`).
TELEGRAM_WEBHOOK_SECRET=""
# Bot sessions, AI chat history, flood counters and the contact form's
# one-message-a-day limit (Upstash Redis → REST API).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── AI (Droid's assistant; off without a key) ──────────────────────────────
# "google" (Gemini, default) or "openai".
AI_PROVIDER=""
# Optional model id override, e.g. gemini-flash-latest or gpt-4o-mini.
AI_CHAT_MODEL=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# ── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
# Server-side purchase conversions, sent from the payment webhook. Use the
# same pixel ids as the web app.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_ACCESS_TOKEN=""
# Events Manager → Test events; remove in production.
META_TEST_EVENT_CODE=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
TIKTOK_EVENTS_ACCESS_TOKEN=""
TIKTOK_TEST_EVENT_CODE=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Better Stack Uptime API token and the public status page URL, for the
# website's footer badge (GET /status).
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""

