# ── App URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"

# ── Cron (Vercel sends it as a Bearer token; `openssl rand -hex 32`) ───────
CRON_SECRET=""

# ── Push notifications (The IDEA iOS/Android apps) ──────────────────────────
# Firebase → Project settings → Service accounts → Generate new private key:
# the JSON file's contents (one line) or base64 of it. Push is off when unset.
FCM_SERVICE_ACCOUNT=""
# Bearer token of the Supabase database webhook on notifications inserts
# (POST /webhooks/notifications; `openssl rand -hex 32`).
PUSH_WEBHOOK_SECRET=""

# ── Google Wallet (The IDEA Pass card) ────────────────────────────────────
# Pay & Wallet Console → Google Wallet API: the issuer ID, and a service
# account key (JSON or base64) added as a user of the issuer. "Add to Google
# Wallet" is hidden when unset.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT=""

# ── Telegram sign-in (The IDEA Pass) ──────────────────────────────────────
# @BotFather → the bot → Login Widget: add the Allowed URL
# <API URL>/auth/telegram/callback and copy the Client ID and Client Secret.
# "Continue with Telegram" is hidden when unset.
TELEGRAM_LOGIN_CLIENT_ID=""
TELEGRAM_LOGIN_CLIENT_SECRET=""

# ── Sign in with The IDEA Pass (partner sites) ───────────────────────────
# The OpenID Connect provider's signing key: a private EC P-256 JWK with a
# kid (JSON or base64). Generate with `bun run --cwd apps/api oidc:key`.
# The /oidc endpoints answer 503 when unset.
PASS_OIDC_SIGNING_KEY=""

# ── Supabase (Settings → API Keys) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ── Payments (Wayl) ────────────────────────────────────────────────────────
# Without WAYL_API_TOKEN the in-memory mock provider is used (development only).
PAYMENTS_PROVIDER=""
WAYL_API_TOKEN=""
# 10–255 random characters; Wayl signs webhooks with it (`openssl rand -hex 32`).
WAYL_WEBHOOK_SECRET=""
# "test" while integrating, "live" for real charges.
WAYL_ENV="test"
# Optional: https://api.thewayl-staging.com for Wayl's staging server.
WAYL_API_URL=""

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Receipts, renewal invoices and the website's contact form (POST /contact,
# delivered to supportEmail in packages/config/project.json).
RESEND_FROM=""
RESEND_TOKEN=""
# Newsletters are sent from Resend Broadcasts. Resend → Audience → Segments:
# create a segment (e.g. "The IDEA customers") and paste its id. Every
# account with an email is synced there daily by GET /cron/newsletter-contacts
# (unsubscribed unless it opted in to marketing email); unsubscribes made in
# Resend flow back to the account. The sync is off while unset.
RESEND_SEGMENT_ID=""
# Optional: gets an email for every paid store order.
STORE_NOTIFICATIONS_EMAIL=""

# ── Delivery with Boxy (tryboxy.com) ───────────────────────────────────────
# Sending orders to Boxy is off while the key or secret is unset. Boxy
# dashboard → Settings → Create a Personal Token. Setup:
# ARCHITECTURE_AND_INTEGRATIONS.md, "Delivery with Boxy".
BOXY_API_KEY=""
BOXY_API_SECRET=""
# Production by default; the sandbox is https://api-stg.tryboxy.dev/api/v1
BOXY_API_URL=""
# Optional: the uid of the pick-up location (warehouse) in Boxy.
BOXY_PICKUP_LOCATION=""
# The custom header (name and value) set on the webhook in Boxy's dashboard.
BOXY_WEBHOOK_HEADER="x-boxy-secret"
BOXY_WEBHOOK_SECRET=""

# ── WhatsApp order updates (Meta WhatsApp Cloud API) ───────────────────────
# Off while the token or the number id is unset. Templates and setup:
# ARCHITECTURE_AND_INTEGRATIONS.md 4.4.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Template language for customers in a language without templates: ar or en.
WHATSAPP_TEMPLATE_LANG="ar"

# ── Security (Arcjet) — the website's public forms ─────────────────────────
# Shield, bot detection, a burst limit and undeliverable-address checks on
# POST /contact (`ajkey_…`). Without it the form still validates and is
# rate limited by Upstash below.
ARCJET_KEY=""

# ── Telegram bot (Droid) ───────────────────────────────────────────────────
# From @BotFather. Then run `bun run --cwd apps/api telegram:setup`.
TELEGRAM_BOT_TOKEN=""
# Sent by Telegram with every webhook call (`openssl rand -hex 32`).
TELEGRAM_WEBHOOK_SECRET=""
# Bot replies in progress, caches and the contact form's
# one-message-a-day limit (Upstash Redis → REST API).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
# Server-side purchase conversions, sent from the payment webhook. Use the
# same pixel ids as the web app.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_ACCESS_TOKEN=""
# Events Manager → Test events; remove in production.
META_TEST_EVENT_CODE=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
TIKTOK_EVENTS_ACCESS_TOKEN=""
TIKTOK_TEST_EVENT_CODE=""

# ── Observability (Sentry, BetterStack) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Better Stack Uptime API token and the public status page URL, for the
# website's footer badge (GET /status).
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""

