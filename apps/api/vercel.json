{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs",
  "crons": [
    {
      "path": "/cron/keep-alive",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/cron/subscriptions",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/push",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/cron/rentals",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/cron/newsletter-contacts",
      "schedule": "0 4 * * *"
    }
  ]
}
