# Public values only: secrets live in apps/api (`bun run check:secrets`).

# ── App URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# apps/api: the contact form and the footer's status badge.
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"

# ── Supabase — public catalog and editorial content (publishable key only) ─
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Analytics ──────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_GTM_ID to manage every tag in Google Tag Manager, or set the
# GA4, Meta and TikTok ids to load those tags directly.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ── Observability (Sentry) ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""
