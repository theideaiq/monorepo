# Public values only: secrets live in apps/api (`bun run check:secrets`).

# ── App URLs ───────────────────────────────────────────────────────────────
# This site, with The IDEA Pass and My Pass (production:
# https://theideaiq.com). The IDEA Pass links (`passUrl()`) point here, and
# the iOS/Android apps load it.
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# The IDEA Partners (apps/partners): partners' pages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# apps/api: checkout, the contact form and the footer's status badge.
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
# Staff (apps/staff): an allowed return_to after sign-in.
NEXT_PUBLIC_STAFF_URL="http://localhost:3003"

# ── Supabase (Settings → API Keys): the publishable key only ──────────────
# Public pages read anonymously; signed-in pages run as the user. Row Level
# Security applies either way.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Session cookie (shared with The IDEA Partners and Staff) ──────────────
# Production: ".theideaiq.com", so every subdomain reads the same session.
# Leave empty locally and on previews (host-only cookie).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""
# Cloudflare Turnstile site key for the sign-in forms (the secret key goes
# in Supabase → Authentication → Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Sign-in providers turned on in Supabase, in button order, e.g.
# "google,apple" (empty: none shown).
NEXT_PUBLIC_AUTH_PROVIDERS=""

# ── Analytics ──────────────────────────────────────────────────────────────
# The GA4, Meta and TikTok ids load those tags directly; events come from
# track() in @repo/analytics/client. Ad pixels never load inside the
# native apps.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ── Observability (Sentry) ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only (source map upload on Vercel).
SENTRY_ORG=""
SENTRY_PROJECT=""
