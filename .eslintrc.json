{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "overrides": [],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "camelcase": "off",
        "eqeqeq": "error",
        "yield-star-spacing": "warn",
        "semi-style": "warn",
        "no-extra-semi": "warn",
        "quotes": ["warn", "double", { "allowTemplateLiterals": true }]
    }
}